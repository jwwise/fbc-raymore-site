<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#
  GitHub Pages cannot issue HTTP 3xx redirects, so pages whose URL changed in
  the rebuild get a meta-refresh stub instead. `noindex` keeps the stub out of
  search results while the canonical tag passes authority to the new URL.
#}
<meta http-equiv="refresh" content="0; url={{ redirectTo }}">
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ redirectTo | absoluteUrl(site.baseUrl) }}">
<title>Redirecting&hellip;</title>
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<div class="wrap prose">
  <h1>This page has moved</h1>
  <p>You are being redirected to <a href="{{ redirectTo }}">{{ redirectTo }}</a>.</p>
</div>
</body>
</html>
